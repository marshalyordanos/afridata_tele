# Copy to apps/server/.env
DATABASE_URL="postgresql://postgres:password@localhost:5432/afridata?schema=public"
PORT=4000
# Signs admin session tokens. Required in production; changing it signs everyone out.
AUTH_SECRET="change-me-to-a-long-random-string"

# Copy to apps/web/.env
VITE_API_URL=http://localhost:4000

# Copy to apps/admin/.env
VITE_API_URL=http://localhost:4000

# Copy to apps/mobile/.env
# Must be reachable FROM THE HANDSET: localhost/127.0.0.1 only work on an
# emulator. On a real phone put THIS machine's LAN IP here — find it with
#   hostname -I
# and replace the <your-lan-ip> below. Leaving this unset is also fine: the
# app then falls back to the Metro host on port 4000, which is usually right.
EXPO_PUBLIC_API_URL=http://<your-lan-ip>:4000
