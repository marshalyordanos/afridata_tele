// Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // The connection URL lives in prisma.config.ts (DATABASE_URL).
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  phone        String        @unique
  name         String
  balance      Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sent         Transaction[] @relation("SentTransactions")
  received     Transaction[] @relation("ReceivedTransactions")
  deposits     Deposit[]
  withdrawals  Withdrawal[]
}

model Transaction {
  id         String            @id @default(cuid())
  amount     Float
  status     TransactionStatus @default(PENDING)
  reference  String            @unique
  note       String?
  createdAt  DateTime          @default(now())

  senderId   String
  sender     User              @relation("SentTransactions", fields: [senderId], references: [id])

  receiverId String
  receiver   User              @relation("ReceivedTransactions", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Deposit {
  id         String        @id @default(cuid())
  reference  String        @unique
  amount     Float
  status     DepositStatus @default(UNCLAIMED)
  createdAt  DateTime      @default(now())
  claimedAt  DateTime?

  userId     String?
  user       User?         @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Withdrawal {
  id        String   @id @default(cuid())
  reference String   @unique
  amount    Float
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum DepositStatus {
  UNCLAIMED
  CLAIMED
}

/// Cash-in/cash-out agents managed from the admin app.
model Agent {
  id             String      @id @default(cuid())
  /// Always stored normalised as +251XXXXXXXXX.
  phone          String      @unique
  fullName       String
  /// Six-digit Telebirr PIN the agent uses on the handset.
  pin            String?
  businessName   String?
  region         String?
  city           String?
  status         AgentStatus @default(PENDING)
  balance        Float       @default(0)
  commissionRate Float       @default(0)
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  depositRequests DepositRequest[]
  cashOutRequests CashOutRequest[]

  @@index([status])
  @@index([createdAt])
}

enum AgentStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

/// Staff who can sign in to the admin console. Only a SUPER_ADMIN may create
/// or remove other admins.
model AdminUser {
  id           String    @id @default(cuid())
  /// The login identifier. Not an Ethiopian mobile number necessarily — the
  /// bootstrap super admin signs in as 0000000000.
  phone        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

/// A customer's deposit check, from the moment it is asked to the moment the
/// agent's handset answers it.
///
/// The record is the server's, not the phone's: it survives a handset reboot,
/// it is what stops the same check being answered twice, and it is the history
/// both the agent's app and the office read back.
model DepositRequest {
  id         String               @id @default(cuid())
  /// Made up by the customer's browser; how the answer finds its way back.
  requestId  String               @unique
  /// Exactly what the customer typed, before any matching.
  reference  String
  status     DepositRequestStatus @default(PENDING)
  /// What telebirr said it was worth. Only ever set alongside CONFIRMED.
  amount     Float?
  /// Why a lookup could not run, e.g. accessibility switched off.
  reason     String?
  createdAt  DateTime             @default(now())
  resolvedAt DateTime?

  agentId    String
  agent      Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([status])
}

enum DepositRequestStatus {
  PENDING
  CONFIRMED
  NOT_FOUND
  FAILED
}

/// A customer's cash-out, from the request to the transfer the handset made.
///
/// The mirror of DepositRequest, and a row for the same reason: the server never
/// performs the transfer — the agent's phone does, out of its own telebirr float
/// — so the request has to outlive both sides being restarted. It is also the
/// only record that money left: telebirr tells nobody but the handset, and
/// without this the payout existed solely in one phone's local storage.
model CashOutRequest {
  id           String               @id @default(cuid())
  /// Issued by the server; how the handset's report finds its way back.
  requestId    String               @unique
  /// The customer's own number, canonical +251 — where the cash-out went.
  phone        String
  /// What the customer asked for. The server never verifies it.
  amount       Float
  status       CashOutRequestStatus @default(PENDING)
  /// Why a transfer could not be made, in the handset's own words.
  reason       String?
  /// telebirr's balance after a completed send, as the handset read it.
  balanceAfter Float?
  createdAt    DateTime             @default(now())
  resolvedAt   DateTime?

  agentId      String
  agent        Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([status])
}

enum CashOutRequestStatus {
  PENDING
  SENT
  FAILED
}
